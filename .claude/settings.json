{
  "permissions": {
    "deny": [
      "Read(~/AppData/Local/PBI_AI_Bridge/**)",
      "Edit(~/AppData/Local/PBI_AI_Bridge/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard-data-access.ps1\""
          }
        ]
      }
    ]
  }
}
